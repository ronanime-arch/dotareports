<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 — ради Windows OCR (ники верхней полосы, TopBarOcr) -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DotaReports</RootNamespace>
    <StartupObject>DotaReports.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <!-- эталоны клеток сетки и слотов верхней полосы, образцы подписей ролей: копируются в папку данных при первом запуске -->
    <None Include="seed\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Remove="testdata\**;dist\**;app\**" />
    <None Remove="testdata\**;dist\**;app\**" />
  </ItemGroup>
</Project>
